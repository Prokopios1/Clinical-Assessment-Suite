<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClinicalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClinicalAssessment">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.patient.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clinical" android:host="connect" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.patient.TestActivity" />
        <activity android:name=".ui.patient.SummaryActivity" />
        <activity android:name=".ui.patient.HistoryActivity" />
        <activity android:name=".ui.patient.AboutAssessmentActivity" />

        <activity android:name=".ui.auth.SignupActivity" />
        <activity android:name=".ui.auth.PatientLoginActivity" />
        <activity android:name=".ui.clinician.ClinicianLoginActivity" />
        <activity android:name=".ui.clinician.DashboardActivity" />
        <activity android:name=".ui.clinician.PatientDetailActivity" />
    </application>

</manifest>
